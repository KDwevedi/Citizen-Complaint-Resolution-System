# Single source of truth for personal-install configuration.
# Sourced by scripts/up.sh; PORT_PREFIX is also passed to ansible-playbook
# via -e so the inventory's kong_url matches.
#
# Override here, then re-run scripts/up.sh.

# Host OS / architecture. Drives platform-specific behavior in up.sh.
#   auto   — detect via uname (default; works for everyone)
#   macos  — Apple Silicon or Intel Mac; sets DOCKER_DEFAULT_PLATFORM=linux/amd64
#            on arm64 so naipepea's amd64-only images run under Rosetta
#   linux  — Native linux; no platform forcing
#   wsl    — Windows via WSL2; treated as linux but with Docker Desktop quirks
OS=auto

# Docker registry where the pre-built DIGIT service images live. The default
# placeholder forces you to set your own — point at a registry your team
# operates (or change to a public mirror you have pull access to). Anonymous
# pull works for some registries; auth pull needs `docker login` first.
#
# When not in `auto` mode for the registry, the override file
# stack/docker-compose.naipepea.yaml uses `${REGISTRY_URL}/...` for every image.
REGISTRY_URL=YOUR_REGISTRY_HOST

# Two-digit prefix that replaces "18" in the upstream compose file's host-side
# port mappings. Pick anything that doesn't collide with what's already on
# your machine.
#
# Defaults rationale:
#   18 — upstream default; collides with naipepea SSH tunnel + dev.sh esbuild
#   16 — recommended default; co-existing with naipepea/dev.sh + docs already
#        reference this range in INFRA-NOTES.md
#   26 — bump if you're already running another DIGIT stack on 16xxx
PORT_PREFIX=16

# Tenant + boundaries seeding mode.
#   true  — ansible creates tenants (PERSONAL_TENANT_ROOT + _CITY) and seeds
#           boundaries from data/boundaries.json. This is the "Nairobi-flavored"
#           install — fastest path to a working PGR demo.
#   false — plain install. Stack only; ansible runs (just for the URLs banner)
#           but skips all seeding. Open the configurator and use the onboarding
#           wizard to create your own tenants and data interactively.
SEED_DEMO_DATA=true

# Tenant taxonomy seeded into MDMS when SEED_DEMO_DATA=true. Override for a
# non-Nairobi opinionated install (e.g. ROOT=in CITY=in.mumbai). Ignored
# entirely when SEED_DEMO_DATA=false.
PERSONAL_TENANT_ROOT=ke
PERSONAL_TENANT_CITY=ke.nairobi

# Bootstrap superuser on the freshly-up stack. CCRS local-setup ships with
# ADMIN/eGov@123 on tenant `pg` — used to authenticate for tenant creation,
# then we create the real ADMIN on the target tenant.
BOOTSTRAP_TENANT=pg
BOOTSTRAP_USER=ADMIN
BOOTSTRAP_PASSWORD=eGov@123

# Where digit-configurator and digit-ui-esbuild are cloned. Defaults assume
# they're siblings of this CCRS clone:
#   ~/repositories/Citizen-Complaint-Resolution-System/   ← this repo
#   ~/repositories/digit-configurator/                    ← sibling
#   ~/repositories/digit-ui-esbuild/                      ← sibling
# Override with absolute paths if your layout differs.
#CONFIGURATOR_DIR=/abs/path/to/digit-configurator
#UI_ESBUILD_DIR=/abs/path/to/digit-ui-esbuild


# Use naipepea's registry images instead of public Docker Hub upstream.
# Default false → fast install, current pgr-dashboard endpoint will 400.
# Set to true to pull ${REGISTRY_URL}/* images (matches naipepea production
# behavior, dashboard works, but +5 GB more to download).
USE_NAIPEPEA_IMAGES=false
